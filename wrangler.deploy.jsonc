{
  "name": "careeros",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "./dist/client"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
  // Data lives in Neon Postgres (secret DATABASE_URL); sign-in uses Neon Auth
  // (NEON_AUTH_BASE_URL, NEON_AUTH_COOKIE_SECRET). The old D1 database "careeros-db"
  // is no longer bound but still exists in Cloudflare as a fallback copy.
}
